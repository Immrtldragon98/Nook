{
  "expo": {
    "name": "Nook",
    "slug": "nook",
    "scheme": "nook",
    "version": "0.2.0",
    "icon": "./assets/icon-v2.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.immrtldragon.nook",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-v2.png",
        "backgroundColor": "#F4F1E8"
      },
      "permissions": ["CAMERA"]
    },
    "plugins": [["expo-camera", {"cameraPermission": "Allow Nook to scan a connection QR code", "recordAudioAndroid": false, "barcodeScannerEnabled": true}]]
  }
}
